#!/usr/bin/env bash
#
# Mock "jira" CLI for the jira-tabbed-tui demo.
#
# jira-tabbed-tui shells out to the `jira` binary (ankitpokhrel/jira-cli) for
# reads and writes. This script stands in for that binary and returns canned,
# deterministic JSON, so the demo GIF can be recorded with no live Jira instance,
# no network, and no credentials. It implements just enough of the CLI surface
# that the TUI exercises: `me`, `issue list --raw`, `issue view --raw`, and
# `issue move` (which is remembered, see "demo state" below).
#
# It is NOT a real Jira client — do not put it on your PATH for actual use.

set -euo pipefail

# Join all args into one string so we can pattern-match the subcommand + flags.
args="$*"

# ---- auth check -------------------------------------------------------------
# The TUI runs `jira me` at startup to verify authentication.
if [[ "$args" == me* ]]; then
  echo "demo.user@example.com"
  exit 0
fi

# ---- demo state --------------------------------------------------------------
# `issue move KEY STATUS` records the new status in $JIRA_DEMO_STATE (one
# "KEY<TAB>STATUS" line per move) so later reads — and the mock REST API in
# demo/mock-jira-api.py — reflect the change.
state="${JIRA_DEMO_STATE:-${TMPDIR:-/tmp}/jira-tabbed-tui-demo.state}"

# status_of KEY DEFAULT — the issue's current status.
status_of() {
  local s=""
  [[ -f "$state" ]] && s="$(awk -F'\t' -v k="$1" '$1 == k { v = $2 } END { print v }' "$state")"
  echo "${s:-$2}"
}

if [[ "$args" == issue\ move* ]]; then
  # Args are: issue move KEY STATUS...
  printf '%s\t%s\n' "$3" "${*:4}" >>"$state"
  exit 0
fi

# ---- issue view KEY --raw ---------------------------------------------------
# Full detail for a single issue: description, comments, subtasks, links.
if [[ "$args" == issue\ view* ]]; then
  # Args are: issue view KEY --raw  -> the key is the 3rd positional arg.
  key="${3:-PLATFORM-142}"

  # Linked issues get their own (smaller) detail so navigating into them from
  # the Links tab shows a different issue.
  case "$key" in
    PLATFORM-151|PLATFORM-152|PLATFORM-98)
      case "$key" in
        PLATFORM-151) sum="Add session-ready guard before first paint"; typ="Sub-task"; st="In Progress"; who="Dana Reyes"
          desc="Delay mounting the login form until the session cookie has been read back, so Safari stops rendering it twice." ;;
        PLATFORM-152) sum="Add Safari smoke test to CI"; typ="Sub-task"; st="To Do"; who="Sam Okafor"
          desc="Run the OAuth login flow in Safari on every PR so the flicker cannot regress." ;;
        PLATFORM-98)  sum="Migrate auth to new session service"; typ="Story"; st="Done"; who="Priya Nair"
          desc="Move login and token refresh onto the new session service." ;;
      esac
      cat <<JSON
{
  "key": "$key",
  "fields": {
    "summary": "$sum",
    "issuetype": { "name": "$typ" },
    "priority": { "name": "Medium" },
    "status": { "name": "$(status_of "$key" "$st")" },
    "assignee": { "displayName": "$who" },
    "reporter": { "displayName": "Dana Reyes" },
    "labels": ["frontend"],
    "created": "2026-09-12T10:00:00.000+0000",
    "updated": "2026-09-18T12:00:00.000+0000",
    "description": "$desc",
    "comment": { "comments": [] },
    "issuelinks": [
      {
        "type": { "inward": "is blocked by", "outward": "blocks" },
        "outwardIssue": { "key": "PLATFORM-142", "fields": { "summary": "Login page flickers on Safari during OAuth redirect", "status": { "name": "$(status_of PLATFORM-142 "In Progress")" } } }
      }
    ]
  }
}
JSON
      exit 0
      ;;
  esac

  cat <<JSON
{
  "key": "$key",
  "fields": {
    "summary": "Login page flickers on Safari during OAuth redirect",
    "issuetype": { "name": "Bug" },
    "priority": { "name": "High" },
    "status": { "name": "$(status_of "$key" "In Progress")" },
    "assignee": { "displayName": "Dana Reyes" },
    "reporter": { "displayName": "Sam Okafor" },
    "labels": ["frontend", "safari", "oauth"],
    "duedate": "2026-09-30",
    "created": "2026-09-10T09:12:00.000+0000",
    "updated": "2026-09-18T16:40:00.000+0000",
    "description": "Users on Safari 17 see a brief white flash and a double-render of the login form when returning from the OAuth provider.\n\nSteps to reproduce:\n1. Open the app in Safari 17\n2. Click \"Sign in with SSO\"\n3. Complete the provider prompt\n4. Observe the flicker as the app rehydrates\n\nLikely a race between the session bootstrap and the first paint. Chrome and Firefox are unaffected.",
    "comment": {
      "comments": [
        {
          "author": { "displayName": "Dana Reyes" },
          "created": "2026-09-18T16:40:00.000+0000",
          "body": "Reproduced. Looks like we mount the form before the session cookie is read back. Testing a guard now."
        },
        {
          "author": { "displayName": "Sam Okafor" },
          "created": "2026-09-11T08:05:00.000+0000",
          "body": "Only happens on the OAuth return path, not on a cold load. Adding the safari label."
        }
      ]
    },
    "subtasks": [
      { "key": "PLATFORM-151", "fields": { "summary": "Add session-ready guard before first paint", "status": { "name": "$(status_of PLATFORM-151 "In Progress")" } } },
      { "key": "PLATFORM-152", "fields": { "summary": "Add Safari smoke test to CI", "status": { "name": "$(status_of PLATFORM-152 "To Do")" } } }
    ],
    "issuelinks": [
      {
        "type": { "inward": "is blocked by", "outward": "blocks" },
        "outwardIssue": { "key": "PLATFORM-98", "fields": { "summary": "Migrate auth to new session service", "status": { "name": "$(status_of PLATFORM-98 "Done")" } } }
      }
    ]
  }
}
JSON
  exit 0
fi

# ---- issue list --raw -q <jql> [--paginate S:N] -----------------------------
# The board rows. We return a different slice depending on the tab's JQL so the
# tabs feel distinct. jira-cli --raw returns the API wrapper object.
if [[ "$args" == issue\ list* ]]; then

  # Child-issue lookup used by the detail view (parent = KEY). Only the main
  # demo issue has children; they are also its subtasks, as in real Jira.
  if [[ "$args" == *"parent ="* ]]; then
    if [[ "$args" != *"parent = PLATFORM-142"* ]]; then
      echo '{ "total": 0, "issues": [] }'
      exit 0
    fi
    cat <<JSON
{ "total": 2, "issues": [
  { "key": "PLATFORM-151", "fields": { "summary": "Add session-ready guard before first paint", "issuetype": {"name":"Sub-task"}, "priority": {"name":"High"}, "status": {"name":"$(status_of PLATFORM-151 "In Progress")"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-12T10:00:00.000+0000", "updated":"2026-09-18T12:00:00.000+0000", "labels":[] } },
  { "key": "PLATFORM-152", "fields": { "summary": "Add Safari smoke test to CI", "issuetype": {"name":"Sub-task"}, "priority": {"name":"Medium"}, "status": {"name":"$(status_of PLATFORM-152 "To Do")"}, "assignee": null, "created":"2026-09-12T10:05:00.000+0000", "updated":"2026-09-12T10:05:00.000+0000", "labels":[] } }
]}
JSON
    exit 0
  fi

  # "In Progress" tab.
  if [[ "$args" == *"In Progress"* ]]; then
    cat <<'JSON'
{ "total": 3, "issues": [
  { "key": "PLATFORM-142", "fields": { "summary": "Login page flickers on Safari during OAuth redirect", "issuetype": {"name":"Bug"}, "priority": {"name":"High"}, "status": {"name":"In Progress"}, "assignee": {"displayName":"Dana Reyes"}, "duedate":"2026-09-30", "created":"2026-09-10T09:12:00.000+0000", "updated":"2026-09-18T16:40:00.000+0000", "labels":["frontend","safari"] } },
  { "key": "PLATFORM-140", "fields": { "summary": "Rate limiter drops burst traffic under 200ms", "issuetype": {"name":"Bug"}, "priority": {"name":"High"}, "status": {"name":"In Progress"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-08T14:00:00.000+0000", "updated":"2026-09-17T11:20:00.000+0000", "labels":["backend"] } },
  { "key": "PLATFORM-133", "fields": { "summary": "Refactor config loader to support env overrides", "issuetype": {"name":"Task"}, "priority": {"name":"Medium"}, "status": {"name":"In Progress"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-05T09:00:00.000+0000", "updated":"2026-09-16T09:00:00.000+0000", "labels":["config"] } }
]}
JSON
    exit 0
  fi

  # "Review" tab.
  if [[ "$args" == *"Review"* || "$args" == *"review"* ]]; then
    cat <<'JSON'
{ "total": 2, "issues": [
  { "key": "PLATFORM-131", "fields": { "summary": "Export dashboard as CSV", "issuetype": {"name":"Story"}, "priority": {"name":"Medium"}, "status": {"name":"In Review"}, "assignee": {"displayName":"Priya Nair"}, "created":"2026-09-03T09:00:00.000+0000", "updated":"2026-09-18T08:30:00.000+0000", "labels":["reporting"] } },
  { "key": "PLATFORM-127", "fields": { "summary": "Tighten JWT expiry validation", "issuetype": {"name":"Bug"}, "priority": {"name":"Highest"}, "status": {"name":"In Review"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-01T09:00:00.000+0000", "updated":"2026-09-17T15:00:00.000+0000", "labels":["security","backend"] } }
]}
JSON
    exit 0
  fi

  # Default: the "Assigned" tab (everything on my plate).
  cat <<'JSON'
{ "total": 6, "issues": [
  { "key": "PLATFORM-142", "fields": { "summary": "Login page flickers on Safari during OAuth redirect", "issuetype": {"name":"Bug"}, "priority": {"name":"High"}, "status": {"name":"In Progress"}, "assignee": {"displayName":"Dana Reyes"}, "duedate":"2026-09-30", "created":"2026-09-10T09:12:00.000+0000", "updated":"2026-09-18T16:40:00.000+0000", "labels":["frontend","safari"] } },
  { "key": "PLATFORM-140", "fields": { "summary": "Rate limiter drops burst traffic under 200ms", "issuetype": {"name":"Bug"}, "priority": {"name":"High"}, "status": {"name":"In Progress"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-08T14:00:00.000+0000", "updated":"2026-09-17T11:20:00.000+0000", "labels":["backend"] } },
  { "key": "PLATFORM-138", "fields": { "summary": "Add pagination to search results", "issuetype": {"name":"Task"}, "priority": {"name":"Medium"}, "status": {"name":"To Do"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-07T09:00:00.000+0000", "updated":"2026-09-15T09:00:00.000+0000", "labels":["search"] } },
  { "key": "PLATFORM-133", "fields": { "summary": "Refactor config loader to support env overrides", "issuetype": {"name":"Task"}, "priority": {"name":"Medium"}, "status": {"name":"In Progress"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-05T09:00:00.000+0000", "updated":"2026-09-16T09:00:00.000+0000", "labels":["config"] } },
  { "key": "PLATFORM-131", "fields": { "summary": "Export dashboard as CSV", "issuetype": {"name":"Story"}, "priority": {"name":"Medium"}, "status": {"name":"In Review"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-03T09:00:00.000+0000", "updated":"2026-09-18T08:30:00.000+0000", "labels":["reporting"] } },
  { "key": "PLATFORM-127", "fields": { "summary": "Tighten JWT expiry validation", "issuetype": {"name":"Bug"}, "priority": {"name":"Highest"}, "status": {"name":"To Do"}, "assignee": {"displayName":"Dana Reyes"}, "created":"2026-09-01T09:00:00.000+0000", "updated":"2026-09-14T15:00:00.000+0000", "labels":["security"] } }
]}
JSON
  exit 0
fi

# Anything else (transitions, edit, assign, comment, ...) is a no-op success so
# the demo never errors out.
exit 0
